<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AtriumRoot Condition="'$(AtriumRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\atrium-desktop</AtriumRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AtriumRoot)/settings/Atrium.Settings/GlassPreview.cs" Link="GlassPreview.cs" />
    <Compile Include="$(AtriumRoot)/settings/Atrium.Settings/CornerProfile.cs" Link="CornerProfile.cs" />
  </ItemGroup>
</Project>
